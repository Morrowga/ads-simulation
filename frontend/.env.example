# Frontend environment (copy to .env.local for local development outside Docker)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_STRIPE_MODE=test        # display only (test | live); no Stripe keys ever go in the browser
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SENTRY_DSN=
# used by `npm run gen:api`
OPENAPI_URL=http://localhost:8000/openapi.json
