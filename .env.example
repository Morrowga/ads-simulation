# ============================================================
# ADVAR local configuration. Copy to .env (make env does this)
# ============================================================

# --- app ---
APP_ENV=local                      # local | test | production
APP_NAME=ADVAR                     # display name; can change without code changes
BASE_CURRENCY=USD                  # all prices and card charges are in USD
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000 # comma-separated list of allowed origins
UID=1000                           # filled in by `make env` with your host user id
GID=1000                           # filled in by `make env` with your host group id
WATCHFILES_FORCE_POLLING=false     # set true on Docker Desktop (Windows/macOS) if reload misses changes
ENGINE_VERSION=1.2.0               # part of the duplicate fingerprint; bump when the engine changes
LOG_LEVEL=INFO

# --- database / redis ---
DATABASE_URL=postgresql+asyncpg://advar:advar@postgres:5432/advar
REDIS_URL=redis://redis:6379/0

# --- auth ---
JWT_SECRET=change-me               # long random string in production
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
STREAM_TOKEN_TTL_SEC=60
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false                # true in production (https only)

# --- storage (MinIO locally) ---
STORAGE_BACKEND=s3                 # s3 | memory | local (memory: test suite only; local: filesystem, dev without MinIO)
STORAGE_LOCAL_DIR=/tmp/advar-storage  # only for STORAGE_BACKEND=local
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000   # used when signing URLs for the browser
S3_BUCKET=advar
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
PRESIGNED_URL_TTL_SEC=600

# --- email ---
MAIL_BACKEND=smtp                  # smtp | memory (memory is used by the test suite only)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_TLS=false
MAIL_FROM=ADVAR <no-reply@advar.local>

# --- LLM ---
LLM_PROVIDER=mock                  # openai | mock (mock runs the whole pipeline without an API key)
OPENAI_API_KEY=                    # put your key here; never sent to the browser
LLM_MODEL_AGENT=gpt-5.6-luna       # verify exact model IDs in the OpenAI dashboard
LLM_MODEL_SMART=gpt-5.6-terra
LLM_MODEL_TRANSCRIBE=gpt-transcribe
LLM_MAX_CONCURRENCY=64
LLM_TEST_TOKEN_BUDGET=3000000
DAILY_LLM_SPEND_CAP_USD=50
LLM_PRICE_JSON={"gpt-5.6-luna":{"in":0.20,"cached_in":0.02,"out":1.20},"gpt-5.6-terra":{"in":2.00,"cached_in":0.20,"out":12.00}}

# --- payments ---
PAYMENT_MODE=mock                  # mock | stripe_test | stripe_live
STRIPE_SECRET_KEY=                 # sk_test_... for stripe_test
STRIPE_WEBHOOK_SECRET=             # whsec_... printed by `docker compose --profile stripe up`
MANUAL_ORDER_EXPIRY_HOURS=48
MANUAL_AUTO_APPROVE_IN_MOCK=false  # mock mode only: approve Myanmar manual orders automatically
# Myanmar payment accounts and social media links are edited in the admin dashboard (settings table),
# seeded with clearly fake example values.

# --- queue ---
QUEUE_BACKEND=arq                  # arq | inline (inline is used by the test suite only)
JOB_TIMEOUT_SEC=1200
STUCK_RUNNING_MINUTES=30
DRAFT_EXPIRY_DAYS=30

# --- seed ---
SEED_ADMIN_EMAIL=admin@advar.local
SEED_ADMIN_PASSWORD=admin12345
